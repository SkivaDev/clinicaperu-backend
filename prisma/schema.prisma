// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PATIENT
  DOCTOR
}

enum Gender {
  MALE
  FEMALE
}

enum SlotStatus {
  FREE
  HELD
  BOOKED
  BLOCKED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  ATTENDED
  CANCELLED
  NO_SHOW
}

enum RoomType {
  CONSULTATION
  SURGERY
  EMERGENCY
  ICU
  LABORATORY
  RADIOLOGY
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

enum EmailTemplate {
  BOOKING_CONFIRMATION
  BOOKING_CANCELLATION
  BOOKING_REMINDER
  PASSWORD_RESET
  WELCOME
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentMethod {
  SIMULATED_CARD
  CASH_AT_CLINIC
}

enum RecordType {
  CONSULTATION
  FOLLOW_UP
  EMERGENCY
}

model User {
  id           String   @id @default(uuid())
  dni          String   @unique
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  dayOfBirth   DateTime
  phone        String?
  gender       Gender
  profileImage String?
  
  role         Role     @default(PATIENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relación uno a uno si el user es un doctor
  doctor Doctor?

  // Relación con citas y correos
  appointments Appointment[]

  // Relación con expedientes médicos
  createdMedicalRecords  MedicalRecord[]           @relation("CreatedMedicalRecords")
  medicalRecordAccess    MedicalRecordAccessLog[]
  refreshTokens          RefreshToken[]

  @@index([lastName])
  @@index([firstName, lastName])
}

// ✅ SEGURIDAD: Modelo para almacenar refresh tokens
// Access token: 15 minutos (corto, en cookie HttpOnly)
// Refresh token: 7 días (largo, en cookie HttpOnly separada)
model RefreshToken {
  id           String   @id @default(uuid())
  token        String   @unique
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?
  
  // Información de seguridad
  ipAddress    String?
  userAgent    String?
  isRevoked    Boolean  @default(false)
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([token])
}

model Clinic {
  id           String  @id @default(uuid())
  name         String  @unique
  address      String
  ubigeoDept   String
  ubigeoProv   String
  ubigeoDist   String
  phone        String?
  email        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rooms        Room[]
  doctors      Doctor[]
  @@index([name])
}

model Room {
  id               String  @id @default(uuid())
  name             String
  roomNumber       String
  roomType         RoomType
  floor            Int
  capacity         Int
  isActive         Boolean   @default(true)
  equipment        String[]  // text[] en Postgres
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  clinicId         String
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, name])
  @@index([roomType])
}

model Specialty {
  id               String @id @default(uuid())
  name             String @unique
  description      String?
  isActive         Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  doctors          Doctor[]
}

model Doctor {
  id            String    @id @default(uuid())
  cmp           Int    @unique // Código de colegiatura

  // Datos profesionales
  isActive          Boolean  @default(true)
  yearsOfExperience Int?
  consultationPrice Float?
  attendedAppointments Int @default(0)
  attendedPatients Int @default(0)
  rating            Float @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Agenda
  schedules          Schedule[]
  unavail            DoctorUnavailability[]
  appointments       Appointment[]

  // Datos laborales del doctor
  specialtyId        String
  specialty          Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  clinicId           String
  clinic             Clinic    @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  // Relación con User
  userId             String    @unique   // vínculo con tabla User
  user               User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([cmp])
  @@index([specialtyId, clinicId])
}

model Schedule {
  id               String   @id @default(uuid())
  dayOfWeek        Int      // 0=Dom, 6=Sáb
  startTime        String   // "08:00"
  endTime          String   // "14:00"
  slotMinutes      Int
  isActive         Boolean  @default(true)
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  slots            Slot[]

  doctorId         String
  doctor           Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, dayOfWeek])
}

model Slot {
  id            String     @id @default(uuid())
  startAt       DateTime
  endAt         DateTime
  status        SlotStatus @default(FREE)
  holdExpiresAt DateTime?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())

  appointment   Appointment?

  scheduleId    String
  schedule      Schedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, startAt])
  @@index([status, startAt])
  @@index([startAt])
}

model Appointment {
  id          String            @id @default(uuid())
  status      AppointmentStatus @default(PENDING)
  reason      String?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  confirmedAt DateTime?
  cancelledAt DateTime?
  cancelledBy String?           // userId de quien canceló
  cancellationReason String?   // Razón de cancelación
  attendedAt  DateTime?

  userId      String            // paciente
  user    User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  doctorId    String
  doctor  Doctor @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  slotId      String            @unique // Cada cita corresponde a un único slot (1:1)
  slot    Slot   @relation(fields: [slotId], references: [id], onDelete: Restrict)
  
  // Relación 1:1 con Payment
  payment     Payment?
  
  // Relación 1:1 con MedicalRecord
  medicalRecord MedicalRecord?

  @@index([doctorId, createdAt])
  @@index([userId, createdAt])
  // Extra: índice parcial raw SQL para asegurar única cita por slot activo
}

model DoctorUnavailability {
  id        String   @id @default(uuid())
  startAt   DateTime
  endAt     DateTime
  reason    String?

  doctorId  String
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startAt, endAt])
}

model EmailMessage {
  id          String       @id @default(uuid())
  to          String
  subject     String
  template    EmailTemplate
  variables   Json         // { patientName: "John", doctorName: "Dr. Smith", date: "..." }
  status      EmailStatus  @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  sentAt      DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([to])
}

model Payment {
  id               String        @id @default(uuid())
  appointmentId    String        @unique
  appointment      Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  
  // Datos financieros
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("PEN")
  status           PaymentStatus @default(PENDING)
  paymentMethod    PaymentMethod
  
  // Identificación de transacción
  transactionId    String        @unique
  
  // Timestamps
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  paidAt           DateTime?
  refundedAt       DateTime?
  expiresAt        DateTime?
  
  // Datos de procesamiento
  processingTimeMs Int?
  retryCount       Int           @default(0)
  failureReason    String?
  
  // Metadatos seguros (NO datos sensibles)
  metadata         Json?
  gatewayResponse  Json?
  
  // Refund
  refundReason     String?
  refundAmount     Decimal?      @db.Decimal(10, 2)
  
  @@index([status, createdAt])
  @@index([transactionId])
  @@index([appointmentId])
}

model PaymentAuditLog {
  id          String        @id @default(uuid())
  paymentId   String
  action      String
  status      PaymentStatus
  metadata    Json
  createdAt   DateTime      @default(now())
  
  @@index([paymentId, createdAt])
}

model MedicalRecord {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  recordDate    DateTime    @default(now())
  recordType    RecordType
  
  // Datos médicos (plaintext)
  diagnosis     String      @db.Text
  prescription  String?     @db.Text
  notes         String?     @db.Text
  vitalSigns    Json?       // {bloodPressure, heartRate, temperature, weight, height}
  
  // Archivos S3
  attachments   Json[]      // [{key, name, uploadedAt, size}]
  
  // Relations
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  createdById   String
  createdBy     User        @relation("CreatedMedicalRecords", fields: [createdById], references: [id], onDelete: Restrict)
  
  // Audit
  accessLogs    MedicalRecordAccessLog[]
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@index([createdById, recordDate])
  @@index([appointmentId])
}

model MedicalRecordAccessLog {
  id        String        @id @default(uuid())
  recordId  String
  userId    String
  action    String        // "CREATE", "VIEW", "DOWNLOAD_PDF", "UPLOAD_FILE"
  metadata  Json?         // {fileName, fileSize, etc}
  createdAt DateTime      @default(now())
  
  record    MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  
  @@index([recordId, createdAt])
  @@index([userId, createdAt])
}