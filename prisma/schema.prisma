// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PATIENT
  DOCTOR
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id           String   @id @default(uuid())
  dni          String   @unique
  email        String   @unique
  passwordHash String
  names        String
  fatherSurname String
  motherSurname String
  dayOfBirth   DateTime
  phone        String?
  gender       Gender
  
  role         Role     @default(PATIENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relación uno a uno si el user es un doctor
  doctor Doctor?
}


model Clinic {
  id        String  @id @default(uuid())
  name      String  @unique
  address   String
  ubigeoDept String?
  ubigeoProv String?
  ubigeoDist String?
  phone     String?

  rooms   Room[]
  doctors Doctor[]
  @@index([name])
}

model Room {
  id       String  @id @default(uuid())
  clinicId String
  name     String
  floor    String?

  clinic   Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  // schedules Schedule[]

  @@unique([clinicId, name])
}

model Specialty {
  id    String @id @default(uuid())
  name  String @unique
  doctors Doctor[]
}

model Doctor {
  id            String    @id @default(uuid())
  cmp           String    @unique // Código de colegiatura
  userId        String    @unique   // vínculo con tabla User
  specialtyId   String
  clinicId      String

  // Datos laborales del doctor
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Restrict)
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  // Relación con User
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // schedules   Schedule[]
  // unavail     DoctorUnavailability[]
  // appointments Appointment[]

  @@index([cmp])
  @@index([specialtyId, clinicId])
}