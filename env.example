# Base de datos PostgreSQL
DATABASE_URL="postgresql://skivadev:root@localhost:5435/clinica-peru-db?schema=public&client_encoding=utf8"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-here"

# Puerto del servidor
PORT=3000

# Configuración de Redis (opcional)
REDIS_URL="redis://localhost:6379"

# Configuración de email - ELEGIR PROVIDER AQUÍ
# Opciones: "mailhog" (desarrollo) o "resend" (producción)
EMAIL_PROVIDER="mailhog"  # ← CAMBIAR A "resend" PARA PRODUCCIÓN

# Configuración MailHog (desarrollo)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@clinicaperu.local"

# Configuración Resend (producción)
RESEND_API_KEY="your-resend-api-key-here"
RESEND_FROM_EMAIL="clinicaperu@resend.dev"