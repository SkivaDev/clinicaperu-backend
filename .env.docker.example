# ============================================
# Docker Compose Environment Variables
# ============================================
# Copia este archivo a `.env` en la misma carpeta que docker-compose.yml
# y personaliza los valores para tu entorno

# ============================================
# PostgreSQL Configuration
# ============================================
# IMPORTANTE: Usa credenciales seguras en producción
# En desarrollo, puedes usar los valores por defecto

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clinicaperu
POSTGRES_PORT=5435

# ============================================
# PRODUCCIÓN - Usa credenciales fuertes
# ============================================
# POSTGRES_USER=clinica_admin_prod
# POSTGRES_PASSWORD=<genera-una-contraseña-fuerte-aquí>
# POSTGRES_DB=clinicaperu_production
# POSTGRES_PORT=5432
