# Copy this file to `.env` and fill in your local values
# Prisma will load this when running via prisma.config.ts

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public&encoding=utf8
# IMPORTANTE: El parámetro encoding=utf8 es necesario para manejar correctamente caracteres con tildes
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinicaperu?schema=public&encoding=utf8"
# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-here"

# Puerto del servidor
PORT=3000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Configuración de email (opcional)
EMAIL_PROVIDER="resend"  # "mailhog" o "resend"

# Configuración MailHog (desarrollo)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@clinicaperuxd.local

# Configuración Resend (producción)
RESEND_API_KEY="your-resend-api-key-here"
RESEND_FROM_EMAIL="noreply@clinicaperudx.com"

# ============================================
# S3 (AWS) CONFIGURATION
# ============================================

# Credenciales de AWS S3
AWS_ACCESS_KEY_ID=AKIA... (tu clave de acceso)
AWS_SECRET_ACCESS_KEY=... (tu secreto)
AWS_REGION=us-east-1 (la región de tu bucket)
S3_BUCKET_NAME=proyecto-clinica-fabrizio-2025 (el nombre de tu bucket)

# ============================================
# PAYMENT SIMULATION CONFIGURATION
# ============================================

# Tasa de éxito de pagos simulados (0.85 = 85%)
PAYMENT_SIMULATION_SUCCESS_RATE=0.85

# Delays de simulación (en milisegundos)
PAYMENT_SIMULATION_MIN_DELAY_MS=1500
PAYMENT_SIMULATION_MAX_DELAY_MS=3000
PAYMENT_SIMULATION_TIMEOUT_MS=30000

# ============================================
# PAYMENT SECURITY
# ============================================

# Secret para firmar webhooks (HMAC)
PAYMENT_WEBHOOK_SECRET=your-super-secret-webhook-key-change-in-production

# Rate limiting de pagos
PAYMENT_RATE_LIMIT_MAX_ATTEMPTS=5
PAYMENT_RATE_LIMIT_WINDOW_SECONDS=120

# ============================================
# PAYMENT BUSINESS RULES
# ============================================

# Tiempo de hold de slot al crear cita (en minutos)
PAYMENT_HOLD_DURATION_MINUTES=15

# Horas mínimas antes de cita para permitir reembolso
PAYMENT_REFUND_MIN_HOURS_BEFORE=24

# Moneda por defecto
PAYMENT_DEFAULT_CURRENCY=PEN